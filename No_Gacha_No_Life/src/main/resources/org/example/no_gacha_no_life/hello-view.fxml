<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #1e1e1e;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="org.example.no_gacha_no_life.HelloController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <Label text="GACHA SYSTEM" textFill="GOLD"><font><Font name="System Bold" size="24.0" /></font></Label>

    <HBox alignment="CENTER" spacing="20">
        <Label fx:id="pityLabel" text="Pity 5 sao: 0" textFill="CYAN" />
        <Label fx:id="guaranteeLabel" text="Bảo hiểm: KHÔNG" textFill="ORANGE" />
    </HBox>

    <VBox alignment="CENTER" prefHeight="300" prefWidth="400" style="-fx-background-color: #2b2b2b; -fx-background-radius: 15;">
        <ImageView fx:id="characterImage" fitHeight="220" fitWidth="180" preserveRatio="true" />
        <Label fx:id="resultLabel" text="Sẵn sàng!" textFill="WHITE"><font><Font name="System Bold" size="18.0" /></font></Label>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#onRoll1Click" style="-fx-background-color: #3498db;" text="QUAY X1" textFill="WHITE" />
        <Button onAction="#onRoll10Click" style="-fx-background-color: #9b59b6;" text="QUAY X10" textFill="WHITE" />
        <Button onAction="#onResetClick" style="-fx-background-color: #e74c3c;" text="RESET" textFill="WHITE" />
    </HBox>

    <TextArea fx:id="historyArea" editable="false" prefHeight="150" style="-fx-control-inner-background: #000; -fx-text-fill: #0f0;" />
</VBox>