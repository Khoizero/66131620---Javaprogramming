<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.no_gacha_no_life.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Hệ Thống Gacha Mô Phỏng" textFill="WHITE">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <HBox alignment="CENTER" spacing="20.0">
        <children>
            <Label fx:id="pityLabel" text="Pity 5 sao: 0" textFill="#00ffcc">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label fx:id="guaranteeLabel" text="Bảo hiểm: Tắt" textFill="#ff5555">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <VBox alignment="CENTER" minHeight="100.0" style="-fx-background-color: #3c3f41; -fx-background-radius: 10;">
        <children>
            <Label fx:id="resultLabel" text="Chúc bạn may mắn!" textFill="WHITE">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </children>
    </VBox>

    <HBox alignment="CENTER" spacing="15.0">
        <children>
            <Button mnemonicParsing="false" onAction="#onRoll1Click" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #4a90e2;" text="Quay x1" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onRoll10Click" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #6c5ce7;" text="Quay x10" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#onResetClick" prefHeight="40.0" prefWidth="80.0" style="-fx-background-color: #e74c3c;" text="Reset" textFill="WHITE" />
        </children>
    </HBox>

    <Label text="Lịch sử quay:" textFill="#bbbbbb" />
    <TextArea fx:id="historyArea" editable="false" prefHeight="200.0" prefWidth="400.0" style="-fx-control-inner-background: #1e1e1e; -fx-text-fill: #ffffff;" wrapText="true" />
</VBox>